# Copy this file to .env and edit to suit your computer.
# Do not commit .env if it contains private paths or other local settings.
# A relative *_DIR is resolved from the folder containing main.py, NOT
# your terminal's / PyCharm's current working directory.
# Absolute paths and ~ are supported using your operating system's syntax.

PDFSPLITTER_INPUT_DIR=.
PDFSPLITTER_INPUT_FILE=ALL.pdf

PDFSPLITTER_CONTACTS_DIR=.
PDFSPLITTER_CONTACTS_FILE=contacts.csv

PDFSPLITTER_OUTPUT_DIR=Renamed_PDFs
